WA_API_TOKEN=replace-with-at-least-20-random-characters

# France Travail
# CLIENT_ID / CLIENT_SECRET sont les seuls identifiants utilisés par toutes les
# APIs France Travail du Worker. Ce sont des secrets Cloudflare, jamais Git.
FRANCE_TRAVAIL_CLIENT_ID=replace-with-france-travail-client-id
FRANCE_TRAVAIL_CLIENT_SECRET=replace-with-france-travail-client-secret

# Compatibilité de l’outil historique Mes Evènements Emploi.
# Les nouveaux outils haut niveau utilisent les scopes/endpoints officiels
# vérifiés et figés côté code ; aucune variable supplémentaire n’est requise.
FRANCE_TRAVAIL_EVENTS_SCOPE=replace-with-events-api-scope
FRANCE_TRAVAIL_EVENTS_URL=https://api.francetravail.io/replace-with-events-api-path
